{
  "name": "minty",
  "version": "0.1.0",
  "private": true,
  "description": "Minty on Cloudflare Workers: one Worker + D1 per household (see docs/serverless-plan.md)",
  "license": "PolyForm-Strict-1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled --var MINTY_DEV_NO_AUTH:1",
    "dev:demo": "wrangler dev --test-scheduled --var MINTY_DEV_NO_AUTH:1 --var MINTY_USERS:me:Alex,sam:Sam",
    "deploy": "node scripts/deploy.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "node scripts/seed.mjs > .wrangler/seed.sql && wrangler d1 execute DB --local --file .wrangler/seed.sql",
    "test": "vitest run",
    "typecheck": "wrangler types && tsc --noEmit",
    "cf-typegen": "wrangler types",
    "test:browser": "npm run build:demo && node --test test/browser/*.test.mjs"
  },
  "dependencies": {
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.7",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "typescript": "^5.9.3",
    "vitest": "~4.1.12",
    "wrangler": "4.152.0"
  }
}
